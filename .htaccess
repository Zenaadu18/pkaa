# ==============================================================================
# JANGKAR NTT - Apache Web Server Security Hardening (.htaccess)
# ==============================================================================

# 1. Nonaktifkan Directory Listing (mencegah penjelajahan isi folder)
Options -Indexes

# 2. Blokir Akses ke File Rahasia / Tersembunyi (.env, .git, .gitignore)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir Akses Langsung ke File Sensitif (.env, .sql, .md, .log, .ini, .json)
<FilesMatch "(?i)\.(env|sql|md|log|ini|json|lock|bak|old)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Blokir Akses Langsung ke Direktori Internal
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(database|scratch)/ - [F,L]
</IfModule>

# 5. Security Response Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
