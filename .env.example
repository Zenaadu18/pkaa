# ==============================================================================
# JANGKAR NTT - Environment Configuration Template
# Sistem Informasi Pajak Kendaraan di Atas Air Provinsi Nusa Tenggara Timur
# Salin file ini menjadi .env dan sesuaikan kredensial server Anda
# ==============================================================================

APP_NAME="JANGKAR NTT"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/PKAA

# Konfigurasi Koneksi Database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_pkaa
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
